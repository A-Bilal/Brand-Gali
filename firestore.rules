rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test document
    match /test/connection {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
             data.uid == uid &&
             data.email is string && data.email.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation for BrandAlert
    function isValidBrandAlert(data, uid, brandId) {
      return data.keys().hasAll(['brandId', 'userId', 'enabled', 'createdAt']) &&
             data.keys().hasOnly(['brandId', 'brandName', 'userId', 'enabled', 'createdAt', 'updatedAt']) &&
             data.brandId == brandId &&
             data.userId == uid &&
             data.enabled is bool &&
             (!('brandName' in data) || (data.brandName is string && data.brandName.size() <= 100)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User Profile match block
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Brand Notifications Subcollection
      match /notifications/{brandId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(brandId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(brandId) && isValidBrandAlert(incoming(), userId, brandId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(brandId) && isValidBrandAlert(incoming(), userId, brandId) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().userId == existing().userId &&
                         incoming().brandId == existing().brandId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(brandId);
      }

      // User Registered Push Notification Devices
      match /devices/{deviceId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(deviceId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(deviceId);
      }
    }
  }
}
